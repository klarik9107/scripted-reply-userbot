# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
# Get these from https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=your_api_hash_here

# Name for the local Telethon session file (creates <SESSION_NAME>.session)
SESSION_NAME=userbot_session

# The account whose incoming messages trigger scripted replies.
# Either a @username or a numeric Telegram user id.
TARGET_USERNAME_OR_ID=@some_username

# Chat to watch for live scenario edits (write '# name' / '-' scripts here).
# Optional - leave blank to disable live reloading.
AUTHORING_CHAT=

# --- Optional: '!notify Text' off-camera notifications ---
NOTIFY_SESSION_NAME=notifier_session
NOTIFY_TARGET=

# --- Optional: pacing / "human typing" tuning (seconds unless noted) ---
READ_DELAY_MIN=1.5
READ_DELAY_MAX=4.0

# Simulated typing speed, in characters per second.
TYPING_CHARS_PER_SECOND=6.0
TYPING_DELAY_MIN=1.0
TYPING_DELAY_MAX=6.0

# Gap between consecutive messages within the same turn.
INTER_MESSAGE_DELAY_MIN=0.8
INTER_MESSAGE_DELAY_MAX=2.5

# --- Optional: reconnection behaviour ---
RECONNECT_RETRIES=10
RECONNECT_DELAY=5.0
